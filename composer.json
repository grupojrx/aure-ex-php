{
  "name": "aure-ex/sdk",
  "description": "SDK oficial da API AureEX para PHP (tipado via OpenAPI)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "AureEx\\": "src/",
      "AureEx\\Generated\\": "generated/lib/"
    }
  },
  "keywords": [
    "aureex",
    "aure-ex",
    "crypto",
    "payments",
    "sdk",
    "openapi"
  ],
  "homepage": "https://api.aure-ex.com/docs/sdks",
  "support": {
    "docs": "https://api.aure-ex.com/docs",
    "source": "https://github.com/grupojrx/aure-ex-php"
  }
}
